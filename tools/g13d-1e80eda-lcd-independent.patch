+
+void G13_Manager::QueueHotplug(libusb_device *dev, libusb_hotplug_event event) {
+  // libusb callbacks may run on either I/O thread. They never mutate/delete devices.
+  {
+    std::lock_guard<std::mutex> lock(hotplug_mutex);
+    hotplug_events.emplace_back(libusb_ref_device(dev), event);
+  }
+  const uint64_t wake = 1;
+  if (wake_fd >= 0) (void)write(wake_fd, &wake, sizeof(wake));
+}
+
+void G13_Manager::ProcessHotplug() {
+  uint64_t wake;
+  if (wake_fd >= 0) (void)read(wake_fd, &wake, sizeof(wake));
+  std::deque<std::pair<libusb_device *, libusb_hotplug_event>> events;
+  {
+    std::lock_guard<std::mutex> lock(hotplug_mutex);
+    events.swap(hotplug_events);
+  }
+  for (auto &event : events) {
+    auto found = std::find_if(g13s.begin(), g13s.end(), [&event](G13_Device *d) {
+      return d->Device() == event.first;
+    });
+    if (event.second == LIBUSB_HOTPLUG_EVENT_DEVICE_ARRIVED) {
+      if (found == g13s.end() && OpenAndAddG13(event.first) == 0) SetupDevice(g13s.back());
+    } else if (found != g13s.end()) {
+      auto *device = *found;
+      g13s.erase(found);
+      delete device; // joins input reader before releasing its USB handle
+    }
+    libusb_unref_device(event.first);
+  }
+}
+
+void G13_Manager::WaitForActivity() {
+  std::vector<pollfd> fds{{wake_fd, POLLIN, 0}};
+  for (auto *d : g13s) {
+    fds.push_back({d->input_wake_fd(), POLLIN, 0});
+    fds.push_back({d->command_fd(), POLLIN, 0});
+  }
+  // FIFO readiness wakes rendering immediately, independent of the USB read timeout.
+  // The bounded timeout also services hotplug when no reader thread/device is present.
+  if (poll(fds.data(), fds.size(), 100) < 0 && errno != EINTR) {
+    G13_ERR("G13 event poll failed: " << strerror(errno));
+    running = false;
+  }
 }
 
